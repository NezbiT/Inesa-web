# INESA Academy — variables de entorno
INESA_JWT_SECRET=cambia-este-secreto-en-produccion
INESA_ADMIN_EMAIL=admin@inesa.com
INESA_ADMIN_PASSWORD=admin123

# IA para generar cursos desde PDF (Grok recomendado)
# Obtén tu key en: https://console.x.ai/
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-non-reasoning

# Proveedor: auto (Grok primero, luego OpenAI), grok, openai
AI_PROVIDER=auto

# Alternativa OpenAI (opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini