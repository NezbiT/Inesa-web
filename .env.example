# INESA Academy — variables de entorno
INESA_JWT_SECRET=cambia-este-secreto-en-produccion
INESA_ADMIN_EMAIL=admin@inesa.com
INESA_ADMIN_PASSWORD=admin123

# Google Gemini — GRATIS (recomendado)
# 1. Ve a https://aistudio.google.com/apikey
# 2. Crea una API key (sin tarjeta de crédito)
# 3. Pégala abajo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_PROVIDER=gemini

# Alternativa Grok (también tiene créditos gratis)
# XAI_API_KEY=
# XAI_MODEL=grok-4-1-fast-non-reasoning
# AI_PROVIDER=grok